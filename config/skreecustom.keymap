#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        enter_or_symbols: enter_or_symbols {
            compatible = "zmk,behavior-hold-tap";
            label = "ENTER_OR_SYMBOLS";
            bindings = <&to>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <100>;
        };

        backspace_or_shift: backspace_or_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "BACKSPACE_OR_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <50>;
            flavor = "tap-preferred";
        };

        kp_or_layer: kp_or_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "KP_OR_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            flavor = "tap-preferred";
        };
    };

    macros {
        emoji_joy: emoji_joy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(U)) &kp N1 &kp F &kp N6 &kp N0 &kp N2 &kp SPACE>;
            label = "😂";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC     &kp N1  &kp N2  &kp N3                    &kp N4     &kp N5          &kp N6         &kp N7       &kp N8        &kp N9   &kp N0      &trans
&trans      &kp Q   &kp W   &kp E                     &kp R      &kp T           &kp Y          &kp U        &kp I         &kp O    &kp P       &trans
&kp ESCAPE  &kp A   &kp S   &kp D                     &kp F      &kp G           &kp H          &kp J        &kp K         &kp L    &lt 3 SEMI  &kp SINGLE_QUOTE
&trans      &kp Z   &kp X   &kp C                     &kp V      &kp B           &kp N          &kp M        &kp COMMA     &kp DOT  &kp FSLH    &trans
            &trans  &trans  &kp LEFT                  &kp RIGHT                                 &kp DOWN     &kp UP_ARROW  &trans   &mo 1
                                                      &kp LCTRL  &kp LALT        &kp HOME       &kp END
                            &mt LEFT_SHIFT BACKSPACE  &kp TAB    &kp HOME        &sl 6          &lt 4 ENTER  &kp SPACE
                                                                 &kp LEFT_WIN    &kp RIGHT_WIN
            >;
        };

        layer_1 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans
            &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans
                                                      &trans        &trans    &trans  &trans
                                        &trans        &trans        &trans    &trans  &trans  &trans
                                                                    &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans                         &trans  &trans  &trans  &trans
                                &trans  &trans    &bootloader  &trans
                        &trans  &trans  &trans    &trans       &trans  &trans
                                        &trans    &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans       &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans    &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans                         &trans  &trans  &trans  &trans
                                &bootloader  &trans    &trans  &trans
                        &trans  &trans       &trans    &trans  &trans  &trans
                                             &trans    &trans
            >;
        };

        Symbols {
            bindings = <
&trans  &kp F1         &kp F2      &kp F3        &kp F4        &kp F5           &kp F6      &kp F7             &kp F8                &kp F9         &kp F10            &kp F11
&trans  &kp LS(EXCL)   &kp LS(AT)  &kp LS(LBRC)  &kp LS(RBRC)  &kp LS(PIPE)     &kp DOLLAR  &kp LESS_THAN      &kp GREATER_THAN      &kp MINUS      &kp LS(PLUS)       &kp F12
&trans  &kp LS(POUND)  &kp DOLLAR  &kp LS(LPAR)  &kp LS(RPAR)  &kp GRAVE        &kp CARET   &kp LEFT_BRACKET   &kp RIGHT_BRACKET     &kp LS(UNDER)  &kp EQUAL          &trans
&trans  &kp LS(PRCNT)  &kp CARET   &kp LS(AMPS)  &kp LS(PLUS)  &kp LS(TILDE)    &kp DOLLAR  &kp DOUBLE_QUOTES  &kp LS(SINGLE_QUOTE)  &kp QUESTION   &kp LS(BACKSLASH)  &trans
        &trans         &trans      &trans        &trans                                     &trans             &trans                &trans         &trans
                                                 &trans        &trans           &trans      &trans
                                   &trans        &trans        &trans           &trans      &trans             &trans
                                                               &trans           &trans
            >;
        };

        vim {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &kp LC(Z)  &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT_ARROW  &kp DOWN   &kp UP  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans     &trans  &trans     &trans  &trans
        &trans  &trans  &trans  &trans                            &trans     &trans  &trans     &trans
                                &trans  &trans    &trans          &trans
                        &trans  &trans  &trans    &trans          &trans     &trans
                                        &trans    &trans
            >;
        };

        Emoji {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans                        &trans  &trans  &trans  &trans
                                &trans  &trans    &trans      &trans
                        &trans  &trans  &trans    &emoji_joy  &trans  &trans
                                        &trans    &trans
            >;
        };
    };
};

// //right hand trackball overrides
// &trackball_peripheral_listener {
//     input-processors =
//         <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,//this gets it to the default installation orientation
//         <&zip_temp_layer 3 500>;//activate layer 3 within 500ms of the trackball moving
// };
// //left hand trackball overrides
// &trackball_central_listener {
//     input-processors = 
//         <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,//this gets it to the default installation orientation
//         <&zip_xy_scaler 1 3>,//multiply sensitivity by 1, divide by 3 (make it slower for scrolling)
//         <&zip_xy_to_scroll_mapper>,//make this trackball output scrolling events by default instead of cursor movement
//         <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;//invert vertical scrolling so that the view moves in the same direction as the top of the trackball.
// };
